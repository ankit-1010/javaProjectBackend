# ==================================================
# MoneyMate Backend Environment Variables Example
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit your .env file containing real credentials!
# ==================================================

# Aiven MySQL Database Configuration
DB_HOST=db_host
DB_PORT=17929
DB_NAME=db_name
DB_USERNAME=username
DB_PASSWORD=YOUR_AIVEN_PASSWORD

# Optional direct DB_URL override (leave commented if using individual fields above)
# DB_URL=your_db_url

# JWT Authentication Secret & Expiration
# In production, replace with your own securely generated 256-bit+ random secret
JWT_SECRET=YOUR_PRODUCTION_256_BIT_SECRET_KEY
JWT_EXPIRATION_MS=86400000

# Server Port (automatically assigned by cloud providers like Render/Railway/Heroku via $PORT)
PORT=8080

# CORS Allowed Origins (Comma-separated exact URLs for frontend, e.g. http://localhost:5173,https://your-frontend.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Admin Initial Seed Credentials (BCrypt hashed on startup)
ADMIN_EMAIL=admin_email
ADMIN_PASSWORD=admin_password
ADMIN_NAME=Admin
